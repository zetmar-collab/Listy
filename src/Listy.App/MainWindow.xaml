<Window x:Class="Listy.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Listy.App"
        Title="{loc:Tr T001}" Icon="Assets/Listy.ico" Style="{StaticResource {x:Type Window}}" Width="1360" Height="900" MinWidth="1100" MinHeight="740" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#172F36">
      <Grid Margin="22,28,22,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="≋  listy" Foreground="White" FontSize="32" FontWeight="Bold"/>
          <TextBlock Text="{loc:Tr T002}" Foreground="#9DB8B1" FontSize="9" Margin="0,8,0,30"/>
          <TextBlock Text="{loc:Tr T003}" Foreground="#9DB8B1" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
          <TextBlock x:Name="LibraryLabel" Text="{loc:Tr T004}" Foreground="White" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock x:Name="LibraryPath" Text="{loc:Tr T005}" Foreground="#A9C2BB" TextWrapping="Wrap" Margin="0,8,0,18" FontSize="11"/>
          <Button Content="{loc:Tr T006}" Click="Browse_Click" Margin="0,0,0,12" Background="#D9EEE1"/>
          <CheckBox x:Name="Recursive" Content="{loc:Tr T007}" IsChecked="True" Foreground="White" Margin="0,0,0,16"/>
          <StackPanel Orientation="Horizontal"><Button x:Name="ScanButton" Content="{loc:Tr T008}" Click="Scan_Click" Padding="13,7"/><Button x:Name="CancelButton" Content="{loc:Tr T009}" Click="Cancel_Click" Padding="13,7" IsEnabled="False"/></StackPanel>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#355058" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,18,0,12">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="TrackCount" Text="0" Foreground="White" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr T010}" Foreground="#A9C2BB"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock x:Name="AlbumCount" Text="0" Foreground="White" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr T011}" Foreground="#A9C2BB" FontSize="11"/></StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="{loc:Tr T012}" Foreground="#9DB8B1" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
          <ListBox x:Name="AlbumList" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Album_Changed" MaxHeight="290">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,5" ToolTip="{Binding Directory}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding TrackCountLabel}" Foreground="#A9C2BB" FontSize="10" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <StackPanel Grid.Row="3"><TextBlock Text="{loc:Tr T132}" Foreground="#9DB8B1" Margin="0,0,0,5"/><ComboBox x:Name="LanguageBox" SelectionChanged="Language_Changed" Margin="0,0,0,14" AutomationProperties.Name="Polski / English"><ComboBoxItem Content="Polski"/><ComboBoxItem Content="English"/></ComboBox><TextBlock Text="{loc:Tr T013}" Foreground="#9DB8B1" FontSize="10"/><TextBlock Text="Listy 1.1  /  Windows" Foreground="#75938C" FontSize="10" Margin="0,5,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="{loc:Tr T014}" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr T015}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E2EDE5" CornerRadius="14" Padding="12,6"><TextBlock Text="{loc:Tr T016}" Foreground="#25684F" FontSize="11"/></Border></Grid>
      <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
        <TabItem Header="{loc:Tr T017}">
          <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="{loc:Tr T018}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0"><TextBlock Text="{loc:Tr T019}" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="Options_Changed"><ComboBoxItem Content="{loc:Tr T020}"/><ComboBoxItem Content="{loc:Tr T021}"/><ComboBoxItem Content="{loc:Tr T022}"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="{loc:Tr T023}" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="NameBox" Text="Playlista" TextChanged="Options_Changed"/><Border x:Name="AlbumNameHint" Background="#EDF3EF" BorderBrush="#CBD9D2" BorderThickness="1" Padding="10,8" Visibility="Collapsed"><TextBlock Text="{loc:Tr T024}" TextWrapping="Wrap" ToolTip="{loc:Tr T025}"/></Border></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="{loc:Tr T026}" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><ComboBox x:Name="FormatBox" SelectedIndex="0" SelectionChanged="Options_Changed"><ComboBoxItem Content="M3U8 · UTF-8"/><ComboBoxItem Content="M3U · UTF-8"/><ComboBoxItem Content="PLS"/><ComboBoxItem Content="XSPF"/><ComboBoxItem Content="WPL"/></ComboBox></StackPanel>
              </Grid>
              <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Tr T027}" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/><TextBox x:Name="SubfolderBox" Text="Playlisty" TextChanged="Options_Changed" Margin="0,0,16,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Bottom"><CheckBox x:Name="RelativeBox" Content="{loc:Tr T028}" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed"/><TextBlock Text="{loc:Tr T029}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Grid>
              <TextBlock Text="{loc:Tr T030}" Foreground="{StaticResource Muted}" Margin="0,16,0,2"/>
              <WrapPanel x:Name="ExtensionPanel"/>
            </StackPanel></Border>
            <Grid Grid.Row="1" Margin="0,20,0,10"><TextBlock Text="{loc:Tr T031}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="PlanSummary" Text="{loc:Tr T032}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></Grid>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><Grid><DataGrid x:Name="PlanGrid" SelectionChanged="Plan_Changed" MouseDoubleClick="Plan_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="{loc:Tr T033}" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="{loc:Tr T034}" Binding="{Binding Count}" Width="80"/><DataGridTextColumn Header="{loc:Tr T035}" Binding="{Binding Folder}" Width="2*"/><DataGridTextColumn Header="{loc:Tr T036}" Binding="{Binding State}" Width="1.4*"/></DataGrid.Columns></DataGrid><TextBlock x:Name="PlanEmpty" Text="{loc:Tr T037}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="22"/></Grid></Border>
            <Grid Grid.Row="3" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><Button Content="{loc:Tr T038}" Click="PlanPreview_Click"/><TextBlock Text="{loc:Tr T039}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></StackPanel><Button x:Name="GenerateButton" Content="{loc:Tr T040}" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="Generate_Click" Margin="0"/></Grid>
          </Grid>
        </TabItem>
        <TabItem Header="{loc:Tr T041}">
          <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16"><TextBlock Text="{loc:Tr T042}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr T043}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="SavedGrid" SelectionMode="Extended" SelectionChanged="Saved_Changed"><DataGrid.Columns><DataGridTextColumn Header="{loc:Tr T044}" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="{loc:Tr T035}" Binding="{Binding Folder}" Width="2*"/></DataGrid.Columns></DataGrid></Border>
            <WrapPanel Grid.Row="2" Margin="0,16,0,0"><Button Content="{loc:Tr T045}" Click="EditSaved_Click"/><Button Content="{loc:Tr T046}" Click="OpenPlaylist_Click"/><Button Content="{loc:Tr T047}" Click="Rename_Click"/><Button Content="{loc:Tr T048}" Click="Delete_Click" Foreground="#AA3D36"/></WrapPanel>
          </Grid>
        </TabItem>
        <TabItem Header="{loc:Tr T049}">
          <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14"><StackPanel><TextBlock x:Name="EditorTitle" Text="{loc:Tr T050}" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="EditorSubtitle" Text="{loc:Tr T051}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="700" HorizontalAlignment="Left"/></StackPanel><TextBlock x:Name="DirtyLabel" Text="{loc:Tr T052}" Foreground="#AC681F" HorizontalAlignment="Right" Visibility="Collapsed"/></Grid>
            <WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button Content="{loc:Tr T053}" Click="New_Click"/><Button Content="{loc:Tr T054}" Click="OpenPlaylist_Click"/><Button Content="{loc:Tr T055}" Click="AddTracks_Click"/><Button Content="{loc:Tr T056}" Click="RemoveTracks_Click"/><Button Content="{loc:Tr T057}" Click="Up_Click"/><Button Content="{loc:Tr T058}" Click="Down_Click"/></WrapPanel>
            <TabControl Grid.Row="2" x:Name="PreviewTabs" SelectionChanged="PreviewTab_Changed"><TabItem Header="{loc:Tr T059}"><Grid><DataGrid x:Name="TracksGrid" CanUserSortColumns="False" SelectionMode="Extended" AllowDrop="True" Drop="Tracks_Drop"><DataGrid.Columns><DataGridTextColumn Header="{loc:Tr T060}" Binding="{Binding Name}" Width="1.5*"/><DataGridTextColumn Header="{loc:Tr T061}" Binding="{Binding Format}" Width="80"/><DataGridTextColumn Header="{loc:Tr T062}" Binding="{Binding Folder}" Width="2*"/><DataGridTextColumn Header="{loc:Tr T063}" Binding="{Binding State}" Width="95"/></DataGrid.Columns></DataGrid><TextBlock x:Name="TracksEmpty" Text="{loc:Tr T064}" TextAlignment="Center" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/></Grid></TabItem><TabItem Header="{loc:Tr T065}"><TextBox x:Name="RawPreview" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/></TabItem></TabControl>
            <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="EditorCount" Text="{loc:Tr T066}" FontWeight="SemiBold"/><CheckBox x:Name="EditorRelative" Content="{loc:Tr T067}" IsChecked="True" Checked="EditorOptions_Changed" Unchecked="EditorOptions_Changed" Margin="0,4,0,0"/></StackPanel><ComboBox Grid.Column="1" x:Name="EditorFormat" SelectedIndex="0" SelectionChanged="EditorOptions_Changed" Margin="0,0,12,0"><ComboBoxItem Content="M3U8 · UTF-8"/><ComboBoxItem Content="M3U · UTF-8"/><ComboBoxItem Content="PLS"/><ComboBoxItem Content="XSPF"/><ComboBoxItem Content="WPL"/></ComboBox><Button Grid.Column="2" Content="{loc:Tr T068}" Style="{StaticResource Primary}" Click="SaveEditor_Click" Margin="0"/></Grid>
          </Grid>
        </TabItem>
      </TabControl>
      <Border Grid.Row="2" Margin="0,18,0,0" BorderBrush="#D9E3DD" BorderThickness="0,1,0,0" Padding="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="{loc:Tr T069}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><Button Grid.Column="1" Content="{loc:Tr T070}" Click="Report_Click" Padding="10,3" Margin="12,0,0,0"/></Grid></Border>
    </Grid>
  </Grid>
</Window>
